# ===== LLM API（OpenAI 兼容接口）=====
# 支持 Poe / OpenAI / Azure / 本地 Ollama 等任何 OpenAI 兼容端点
API_KEY=your_api_key_here
API_BASE_URL=https://api.poe.com/v1
CLAUDE_MODEL=claude-opus-4-6

# ===== 检索 / RAG 参数（可选，均有默认值）=====
# 检索引擎：BM25Okapi + jieba（中文医疗词典）+ 向量语义召回，RRF 融合，本地 SQLite
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K=5

# ===== 向量 embedding =====
# EMBEDDING_MODE=local            # local=本地 bge（默认，无外部依赖）；remote=远程 OpenAI 兼容服务
# 本地模式（默认）：首次自动下载 BAAI/bge-large-zh-v1.5（约 1.3GB）到 ~/.cache/huggingface
# EMBEDDING_HF_NAME=BAAI/bge-large-zh-v1.5
# EMBEDDING_DEVICE=auto           # auto|cpu|cuda（auto：有 GPU 用 cuda，否则 cpu）
# HF_ENDPOINT=https://huggingface.co   # 首次下载端点（注意 hf-mirror.com 会 308 回跳致 HF 库 HEAD 失败）
# --- remote 模式才需要 ---
# EMBEDDING_BASE_URL=http://your-xinference-host:9997/v1
# EMBEDDING_MODEL=bge-large-zh-v1.5

# ===== 账号登录：飞书验证码发送机器人（可选，企业官方机器人对全员可用）=====
# NOTIFY_APP_ID=cli_xxx
# NOTIFY_APP_SECRET=xxx
# LARK_DOMAIN=https://open.feishu.cn   # Lark 国际版：https://open.larksuite.com

# ===== 服务 =====
# HOST=0.0.0.0
# PORT=8003
