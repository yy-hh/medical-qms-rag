# ===== LLM API（OpenAI 兼容接口）=====
# 支持 Poe / OpenAI / Azure / 本地 Ollama 等任何 OpenAI 兼容端点
API_KEY=your_api_key_here
API_BASE_URL=https://api.poe.com/v1
CLAUDE_MODEL=claude-opus-4-6

# ===== 检索 / RAG 参数（可选，均有默认值）=====
# 检索引擎为 BM25Okapi + jieba（中文医疗词典）+ 本地 SQLite，无需向量库/embedding
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K=5

# ===== 服务 =====
# HOST=0.0.0.0
# PORT=8003
