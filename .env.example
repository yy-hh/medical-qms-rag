# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Embedding model (default: BAAI/bge-small-zh-v1.5)
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DEVICE=cpu  # or cuda

# Vector store path (default: ./vector_store)
# CHROMA_PERSIST_DIR=./vector_store

# Default collection name
# DEFAULT_COLLECTION=medical_qms

# RAG parameters
# CHUNK_SIZE=512
# CHUNK_OVERLAP=64
# TOP_K=5

# Server
# HOST=0.0.0.0
# PORT=8003
